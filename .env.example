# Docker Compose loads this file as .env; a manual Python installation must
# export these settings itself. Never commit your actual .env file.
DATABASE=instance/wichtelwerk.db
BASE_URL=https://wichtelwerk.example.com
COOKIE_SECURE=true
MAIL_MODE=smtp
MAIL_FROM=wichtelwerk@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
PUBLIC_EVENT_CREATION=false
EVENT_CREATOR_EMAILS=admin@example.com
